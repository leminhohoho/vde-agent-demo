# insight plugin environment. Copy to agents/insight/.env and fill in.
# The plugin reads this file itself at Backend startup (never into os.environ); its values win over
# the Backend's process environment. Never committed, never copied into Docker images.
# Model ids, limits and prices live in config/llm.yaml, not here.

# LLM keys. Gemini is the primary provider, OpenAI (Responses API) the fallback.
# No key at all → TEMPLATE mode (fixed Vietnamese templates, no LLM cost).
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint instead of api.openai.com.
OPENAI_BASE_URL=

# Optional: gemini | openai → use only that provider, no fallback.
# INSIGHT_FORCE_PROVIDER=
# Optional: off → TEMPLATE mode even with keys.
# INSIGHT_LLM=off

# Data source (D-77): export (the data pack in <repo>/export, default when present) | fixtures
# (the 81-unit cut in vdagent_insight/tests/fixtures/export_sample).
# INSIGHT_ARTIFACT_SOURCE=export
# INSIGHT_EXPORT_DIR=
# SQLite store of artifacts and LLM usage (default <repo>/var/insight_artifacts.db, D-51).
# INSIGHT_STORE_PATH=
