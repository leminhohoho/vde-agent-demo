# data agent environment. Copy to agents/data/.env and fill in the LLM settings.
# This file's values win over the process environment; any .env above the agent folder only fills
# variables still unset. Never committed, never copied into Docker images.

# Backend agent hub (host:port). Default localhost:50050. For a remote Backend use
# <backend-host>:50050. Docker compose overrides it with backend:50050.
VDAGENT_BACKEND=localhost:50050

# Required: an OpenAI-compatible endpoint whose model supports tool calling.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://…/v1
LLM_MODEL=

# Optional: timeout per LLM call, in seconds (default 120).
LLM_TIMEOUT_S=120
