# Agent environment. Copy to agents/<name>/.env when you create an agent from this template.
# This file's values win over the process environment; any .env above the agent folder only fills
# variables still unset. Never committed, never copied into Docker images.

# Backend agent hub (host:port). The agent connects as `NAME` from agent.py, which must be listed
# under `agents:` in backend/config.yaml.
VDAGENT_BACKEND=localhost:50050

# Add the settings your brain reads in build_agent() below (e.g. an LLM endpoint). The echo stub
# needs none. The LiteLLM agents use:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://…/v1
# LLM_MODEL=
# LLM_TIMEOUT_S=120
